{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "checks", "issues", "next_action"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "summary": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL", "WARNING"]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "issue", "required_action"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "BLOCKER"]
          },
          "file": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "required_action": {
            "type": "string"
          }
        }
      }
    },
    "next_action": {
      "type": "string",
      "enum": ["NONE", "REANALYZE"]
    }
  }
}
