{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "menuItemId": {
      "type": "string",
      "description": "Identidad del combo.",
      "minLength": 1
    },
    "menuItemVersion": {
      "type": "string",
      "description": "Versión comercial leída; no cambia al atender un aviso.",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "description": "Estado administrativo de revisión, independiente de disponibilidad y estado de venta.",
      "enum": [
        "UP_TO_DATE",
        "REVIEW_REQUIRED"
      ]
    },
    "configurations": {
      "type": "array",
      "items": {
        "$ref": "ConfigurationReview.schema.json",
        "description": "Revisión individual."
      },
      "description": "Todas las ComboConfiguration del combo, incluidas las archivadas."
    }
  },
  "required": [
    "menuItemId",
    "menuItemVersion",
    "state",
    "configurations"
  ],
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "REVIEW_REQUIRED", "description": "Resumen pendiente."}}},
      "then": {"properties": {"configurations": {"description": "Existe una configuración pendiente.", "contains": {"properties": {"state": {"const": "REVIEW_REQUIRED", "description": "Configuración pendiente."}}, "required": ["state"]}}}},
      "else": {"properties": {"configurations": {"description": "Ninguna configuración está pendiente.", "items": {"properties": {"state": {"const": "UP_TO_DATE", "description": "Configuración sin pendientes."}}}}}}
    }
  ],
  "additionalProperties": false
}
