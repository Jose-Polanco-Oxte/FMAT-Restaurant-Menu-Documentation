{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "configurations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "configurationId": {
            "type": "string",
            "description": "Configuración de combo que se confirma.",
            "minLength": 1
          },
          "reviewToken": {
            "type": "string",
            "description": "Token de E-20 que delimita únicamente cambios vistos.",
            "minLength": 1
          }
        },
        "required": [
          "configurationId",
          "reviewToken"
        ],
        "additionalProperties": false
      },
      "description": "Una, varias o todas las configuraciones mostradas; no existe comodín de cambios futuros.",
      "minItems": 1
    }
  },
  "required": [
    "configurations"
  ],
  "additionalProperties": false
}
