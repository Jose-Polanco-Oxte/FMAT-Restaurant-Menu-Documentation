{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slotId": {
      "type": "string",
      "description": "Slot de la referencia visual.",
      "minLength": 1
    },
    "baseOptionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Opción base.",
        "minLength": 1
      },
      "description": "Selección administrativa; no determina cobro.",
      "uniqueItems": true
    },
    "saved": {
      "$ref": "Money.schema.json",
      "description": "Suma de precios fijados por cantidades suministradas."
    },
    "current": {
      "$ref": "Money.schema.json",
      "description": "Suma con precios actuales de las mismas variantes y cantidades."
    },
    "difference": {
      "type": "string",
      "description": "Importe actual menos guardado; puede ser negativo y no es precio de venta.",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    }
  },
  "required": [
    "slotId",
    "baseOptionIds",
    "saved",
    "current",
    "difference"
  ],
  "additionalProperties": false
}
